{
  "name": "logicaos",
  "version": "1.9.147",
  "description": "Sistema de Agentes Autônomos — LogicaOS",
  "scripts": {
    "start": "export PATH=\"$HOME/.local/node/bin:$PATH\"; [ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" 2>/dev/null || true; npx pm2 start ecosystem.config.js && npx pm2 save",
    "stop": "npx pm2 stop all",
    "restart": "npx pm2 restart all",
    "logs": "npx pm2 logs",
    "status": "npx pm2 list",
    "setup": "node setup.js",
    "synapses": "node synapses/index.js",
    "test": "node synapses/tests/smoke.test.js && node synapses/tests/supabase-circuit-breaker-startup.test.js",
    "test:watch": "vitest",
    "test:telegram": "node channels/telegram/tests/integration.test.js",
    "test:telegram-e2e": "node channels/telegram/tests/e2e.test.js",
    "check:article-images": "node scripts/validate-article-images.mjs",
    "check:destination-images": "node scripts/validate-destination-images.mjs",
    "check:all": "npm run check:article-images && npm run check:destination-images && npm run check:forbidden 2>/dev/null || true",
    "new:article": "node scripts/new-article.mjs",
    "new:destination": "node scripts/new-destination.mjs",
    "prebuild": "npm run check:article-images && npm run check:destination-images",
    "optimize:imgs": "bash scripts/optimize-and-upload.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.77",
    "@anthropic-ai/sdk": "^0.79.0",
    "@bull-board/api": "^6.20.5",
    "@bull-board/express": "^6.20.5",
    "@google/genai": "^1.44.0",
    "@supabase/supabase-js": "^2.97.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "bullmq": "^5.71.0",
    "bytenode": "^1.5.0",
    "canvas": "^3.2.3",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "js-yaml": "^4.1.1",
    "lru-cache": "^11.2.7",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.25.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "playwright": "^1.58.2",
    "pm2": "^5.4.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "undici": "^6.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
